# Local development only: where to proxy /api/* when running the backend
# separately (`npm run dev` in backend/). Leave unset on Vercel, where
# vercel.json routes /api/* to the backend service.
BACKEND_URL=http://localhost:4000

# Public URL of this site, used for canonical URLs, Open Graph and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (not wired up yet)
NEXT_PUBLIC_ANALYTICS_ID=

# Footer contact links. LinkedIn is hidden until a URL is set.
NEXT_PUBLIC_CONTACT_EMAIL=design@graphikx.in
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/graphikxstudio/
