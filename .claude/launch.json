{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": ["BACKEND_URL=http://localhost:4100", "npm", "run", "dev", "--prefix", "frontend"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=4100", "npm", "run", "dev", "--prefix", "backend"],
      "port": 4100,
      "autoPort": false
    }
  ]
}
