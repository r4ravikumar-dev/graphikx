# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Database (not used yet; reserved for when enquiries and content are persisted)
DATABASE_URL=

# Email notifications for project enquiries.
# Leave EMAIL_HOST empty to log enquiries to the console instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
ENQUIRY_NOTIFY_TO=design@graphikx.in
