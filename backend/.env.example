# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Database (not used yet; reserved for when enquiries and content are persisted)
DATABASE_URL=

# Email notifications for project enquiries (graphikx.in mail runs on Zoho).
# Leave EMAIL_HOST empty to log enquiries to the console instead of sending them;
# in production an empty EMAIL_HOST makes the form show an error instead.
# Zoho: EMAIL_HOST=smtp.zoho.in, EMAIL_PORT=465, EMAIL_USER=design@graphikx.in,
# EMAIL_PASSWORD=<a Zoho app-specific password>, EMAIL_FROM="Graphikx Website <design@graphikx.in>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
ENQUIRY_NOTIFY_TO=design@graphikx.in
